{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roweb.local/contracts/gateway-error.schema.json",
  "title": "ROWEB Gateway Error",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "error_code", "message", "retryable", "occurred_at", "session_correlation_id"],
  "properties": {
    "schema_version": {"const": 1},
    "error_code": {
      "enum": [
        "ticket.invalid",
        "ticket.expired",
        "ticket.replayed",
        "origin.rejected",
        "compatibility.rejected",
        "upstream.unavailable",
        "session.protocol-error",
        "session.rate-limited",
        "session.closed"
      ]
    },
    "message": {"type": "string", "minLength": 1, "maxLength": 240},
    "retryable": {"type": "boolean"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "session_correlation_id": {"type": "string", "format": "uuid"},
    "retry_after_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
  }
}
